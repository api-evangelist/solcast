{
  "info": {
    "_postman_id": "5a521105-9431-4ded-bebb-73ccccfe50aa",
    "name": "Solcast Aggregations API",
    "description": "The Solcast API provides live, forecast, historical, and typical meteorological year (TMY) solar irradiance, PV power, and weather data derived from a global fleet of weather satellites. Data covers rooftop PV, advanced PV, grid aggregations, and soiling loss models (Kimber and HSU) globally. Solcast is part of DNV's Green Data Products suite. Authentication uses an API key passed via the Authorization header.\n\nContact Support:\n Name: Solcast Support",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T02:57:32.000Z",
    "updatedAt": "2026-07-28T02:57:33.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-5a521105-9431-4ded-bebb-73ccccfe50aa"
  },
